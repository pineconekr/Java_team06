package library;

import library.repository.*;
import library.service.BorrowSvc;
import library.ui.LibraryMainUI;

public class Main {
    public static void main(String[] args) {
        // 1. 싱글톤(Singleton) 패턴 기반의 리포지토리 객체 로드
        IBookRepository bookRepo = InMemoryBookRepository.getInstance();
        IMemberRepository memberRepo = InMemoryMemberRepository.getInstance();
        ILoanRepository loanRepo = InMemoryLoanRepository.getInstance();

        // 2. 비즈니스 로직 처리를 위한 서비스 계층 생성 및 의존성 주입(DI)
        BorrowSvc borrowSvc = new BorrowSvc(bookRepo, memberRepo, loanRepo);

        // 3. 서비스 객체들을 메인 UI 컨테이너에 전달하며 프로그램 실행
        new LibraryMainUI(borrowSvc);
    }
}
